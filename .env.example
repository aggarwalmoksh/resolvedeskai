# Telegram Bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Public base URL of your server (e.g. from ngrok, Cloudflare Tunnel, or production domain)
# Example: https://xxxx-xx-xx.ngrok-free.app
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Optional secret token to verify that requests originate from Telegram webhook
SECRET_TOKEN=your_random_secret_token

# Set to 1 to strictly reject webhook requests with 401 if secret token mismatches.
# Defaults to 0 (permissive mode: logs a detailed warning but accepts the message so dev doesn't break)
ENFORCE_SECRET_TOKEN=0

# Port for the Express server
PORT=4000

# Set to 1 to have the bot reply "Received: <your text>" to each message
ECHO=0
